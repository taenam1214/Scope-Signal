# ---------------------------------------------------------------------------
# ScopeSignal environment variables
# Copy this file to `.env.local` and fill in real values for local development.
# In production (Vercel), set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://scope-signal.com

# --- Contact form email delivery (Resend: https://resend.com) ---
# If RESEND_API_KEY is set, contact-form submissions are emailed via Resend.
# If it is NOT set, submissions are written to ./.submissions/submissions.jsonl
# as a local fallback (development only — Vercel's filesystem is ephemeral,
# so you MUST configure Resend for production email delivery).
RESEND_API_KEY=

# Verified "from" address on your Resend account.
# Until scope-signal.com is verified in Resend, keep the onboarding@resend.dev sender.
# After domain verification, switch to e.g. "ScopeSignal <hello@scope-signal.com>".
CONTACT_FROM_EMAIL="ScopeSignal <onboarding@resend.dev>"

# Where contact-form notifications should be delivered.
CONTACT_TO_EMAIL=taenamkim@scope-signal.com
